<Window
    x:Class="CodeDiffStudio.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:CodeDiffStudio"
    xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
    mc:Ignorable="d"
    PreviewKeyDown="MainWindow_PreviewKeyDown"
    Title="MainWindow"
    MinWidth="640"
    MinHeight="360"
    Height="450"
    Width="800">
    <Grid
        Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="*" />
            <RowDefinition
                Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition
                Width="*" />
            <ColumnDefinition
                Width="*" />
        </Grid.ColumnDefinitions>
        <Button
            Grid.Row="0"
            Content="Open Left"
            HorizontalAlignment="Left"
            Padding="10,4"
            Height="26"
            Margin="0,0,0,28"
            Grid.RowSpan="2"
            VerticalAlignment="Bottom"
            Click="OpenLeft_Click"
            x:Name="OpenLeftButton" />
        <TextBlock
            x:Name="LeftFileName"
            Grid.Row="1"
            Text="No file selected"
            Margin="0,8,0,4" />
        <avalonEdit:TextEditor
            x:Name="LeftFileContents"
            Grid.Row="2"
            AutomationProperties.Name="Left file contents"
            IsReadOnly="True"
            ShowLineNumbers="True"
            FontFamily="Consolas"
            FontSize="14"
            WordWrap="False"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto" />
        <Button
            x:Name="OpenRightButton"
            Grid.Row="0"
            Grid.Column="1"
            Content="Open Right"
            HorizontalAlignment="Left"
            Margin="8,0,0,0"
            Padding="10,4"
            Click="OpenRight_Click" />
        <TextBlock
            x:Name="RightFileName"
            Grid.Row="1"
            Grid.Column="1"
            Text="No file selected"
            Margin="8,8,0,4" />
        <avalonEdit:TextEditor
            x:Name="RightFileContents"
            Grid.Row="2"
            Grid.Column="1"
            Margin="8,0,0,0"
            AutomationProperties.Name="Right file contents"
            IsReadOnly="True"
            ShowLineNumbers="True"
            FontFamily="Consolas"
            FontSize="14"
            WordWrap="False"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto" />
        <TextBox
            x:Name="ComparisonStatus"
            Grid.Row="3"
            Grid.ColumnSpan="2"
            Margin="0,8,0,0"
            Padding="4"
            MaxHeight="96"
            IsReadOnly="True"
            IsReadOnlyCaretVisible="True"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled"
            AutomationProperties.Name="Comparison status and file errors"
            AutomationProperties.HelpText="Use arrow keys to read the message, or Ctrl+A and Ctrl+C to copy it."
            Text="Open two files to compare." />
        <Button
            x:Name="RefreshButton"
            Grid.Column="1"
            Content="Refresh"
            HorizontalAlignment="Right"
            Padding="10,4"
            Grid.Row="0"
            Click="Refresh_Click" />
    </Grid>
</Window>
